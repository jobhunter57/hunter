@echo off
REM =====================================================================
REM   Email settings for RoleDar (Windows)
REM =====================================================================
REM
REM   This is a TEMPLATE. To use it (see the README "Setting up a local
REM   schedule" section):
REM     1. Copy it:   copy local-secrets.bat.example local-secrets.bat
REM     2. Add  local-secrets.bat  to your .gitignore
REM     3. Replace the three example values below with your real ones
REM
REM   Want CSV reports only, no email? You don't need this file at all.
REM   Don't copy it, and the scraper writes reports without emailing.
REM
REM   Where the values come from (see the README "Set up email" section):
REM     RESEND_API_KEY  - created in your resend.com dashboard, starts "re_"
REM     FROM_EMAIL      - who the mail is "from" (onboarding@resend.dev is fine)
REM     NOTIFY_EMAIL    - where the mail should go (your own address)
REM =====================================================================

set RESEND_API_KEY=
set FROM_EMAIL=
set NOTIFY_EMAIL=
